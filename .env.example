# Supabase (obrigatório)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
PRIVATE_SUPABASE_SERVICE_KEY=your-service-role-key-here

# URL pública do site (obrigatório — usado nos links dos emails)
NEXT_PUBLIC_SITE_URL=https://cliente.grupototum.com

# Email transacional — Resend (obrigatório para envio de convites e onboarding)
RESEND_API_KEY=re_your-resend-api-key-here

# Remetente padrão do onboarding (opcional)
# ONBOARDING_FROM_EMAIL=Totum <contato@grupototum.com>

# SMTP alternativo (opcional — fallback se Resend não estiver configurado)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=seu-email@gmail.com
# SMTP_PASS=sua-senha-de-app
# SMTP_FROM=Totum <seu-email@gmail.com>

# Tema (opcional, padrão: theme-totum)
NEXT_PUBLIC_THEME=theme-totum

# Nome do produto (aparece no navbar e emails)
NEXT_PUBLIC_PRODUCTNAME=Totum

# SSO Providers (opcional, ex: google,github)
# NEXT_PUBLIC_SSO_PROVIDERS=google

# ==========================================
# Fase 2 — Integrações (deixar comentado por enquanto)
# ==========================================
# UPIXEL_API_URL=https://upixel-api.grupototum.com
# UPIXEL_API_KEY=

# AGENDAMENTO_API_URL=https://agenda.grupototum.com
# AGENDAMENTO_API_KEY=

# TOTUM_SYSTEM_API_URL=https://admin.grupototum.com
# TOTUM_SYSTEM_API_KEY=

# Google Drive OAuth
# GOOGLE_DRIVE_CLIENT_ID=
# GOOGLE_DRIVE_CLIENT_SECRET=
